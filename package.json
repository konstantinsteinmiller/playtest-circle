{
  "name": "playtest-circle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply playtest-circle --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply playtest-circle --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@intlify/message-compiler": "11.4.14",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.149.0"
  }
}
